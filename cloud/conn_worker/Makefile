proto:
	@protoc --go_out=./interface/grpc --go_opt=paths=source_relative \
		--go-grpc_out=./interface/grpc --go-grpc_opt=paths=source_relative \
		-I interface/grpc \
		interface/grpc/conn_worker.proto
	@echo "Proto files generated successfully."
	@echo "autogenerated files at: interface/grpc/"

build:
	go build -o bin/conn-worker ./cmd/main.go

run: build redis-up
	./bin/conn-worker

redis-up:
	-docker run --name redis -d -p 6379:6379 redis

redis-down:
	-docker stop redis
	-docker rm redis

clean:
	-docker stop redis
	-docker rm redis
	-rm -rf bin
