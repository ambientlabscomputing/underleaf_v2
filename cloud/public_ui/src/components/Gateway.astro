---
const points = [
	'Pick a service in your manifest to expose and it gets its own address.',
	'Your nodes dial out to the gateway, so nothing on your network has to listen to the internet.',
	'Traffic is metered, and that metering is the only thing that costs money.',
];
---

<section class="section" id="gateway">
	<div class="container split">
		<div>
			<p class="eyebrow">Cloud Gateway</p>
			<h2>Share an app without opening your network</h2>
			<p class="body">
				Most apps never need to leave your LAN. For the ones that do, the gateway hands out a public
				address and relays requests down a tunnel your node opened itself.
			</p>
		</div>
		<ul class="card">
			{
				points.map((p) => (
					<li>
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12.5l4.5 4.5L19 7.5" />
						</svg>
						<span>{p}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 56px;
		align-items: center;
	}

	h2 {
		margin: 10px 0 16px;
		font-size: clamp(26px, 4vw, 34px);
	}

	.body {
		color: var(--muted);
		font-size: 17px;
	}

	ul {
		list-style: none;
		margin: 0;
		display: grid;
		gap: 22px;
	}

	li {
		display: flex;
		gap: 14px;
		align-items: flex-start;
	}

	li svg {
		flex: none;
		margin-top: 4px;
		color: var(--accent);
	}

	@media (max-width: 860px) {
		.split {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}
</style>
