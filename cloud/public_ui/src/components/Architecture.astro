---
const parts = [
	{
		name: 'Orchestrator',
		tag: 'On your manager node',
		body: 'Keeps the plan for your cluster and reconciles it. Ships with a REST API and a local web UI.',
	},
	{
		name: 'Agents',
		tag: 'On every node',
		body: 'Run your containers and talk to each other over the mesh. Small enough to put anywhere.',
	},
	{
		name: 'Cloud Gateway',
		tag: 'Optional, hosted by us',
		body: 'Gives an app a public address and carries its traffic through an authenticated tunnel. Metered by usage.',
	},
];
---

<section class="section alt" id="how-it-works">
	<div class="container">
		<div class="section-head">
			<h2>Local by default, cloud when you ask for it</h2>
			<p>The cloud handles accounts, billing and gateways. Your cluster handles everything else.</p>
		</div>

		<div class="diagram" role="img" aria-label="Agents on your nodes connect to the orchestrator and to each other; optionally, they connect out to the Cloud Gateway.">
			<div class="zone local">
				<span class="zone-label">Your hardware</span>
				<div class="row">
					<div class="node strong">Orchestrator</div>
					<div class="node">Agent</div>
					<div class="node">Agent</div>
				</div>
			</div>
			<div class="link" aria-hidden="true"><span>outbound, mutually authenticated</span></div>
			<div class="zone cloud">
				<span class="zone-label">Underleaf Cloud</span>
				<div class="row">
					<div class="node">Accounts &amp; billing</div>
					<div class="node strong">Cloud Gateway</div>
				</div>
			</div>
		</div>

		<div class="parts">
			{
				parts.map((p) => (
					<div class="part">
						<p class="eyebrow">{p.tag}</p>
						<h3>{p.name}</h3>
						<p>{p.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.alt {
		background: var(--bg-raised);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.diagram {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: stretch;
		gap: 0;
		max-width: 920px;
		margin: 0 auto 56px;
	}

	.zone {
		position: relative;
		border: 1px dashed var(--border-strong);
		border-radius: var(--radius);
		padding: 40px 24px 24px;
		background: var(--surface);
	}

	.zone.local {
		border-color: var(--accent-border);
	}

	.zone-label {
		position: absolute;
		top: 14px;
		left: 20px;
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.local .zone-label {
		color: var(--accent);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.node {
		flex: 1 1 auto;
		text-align: center;
		padding: 12px 16px;
		font-size: 14px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: rgba(8, 10, 14, 0.8);
		color: var(--heading);
	}

	.node.strong {
		border-color: var(--accent-border);
		background: var(--accent-bg);
		color: var(--accent);
	}

	.link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 140px;
		position: relative;
	}

	.link::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		border-top: 1px dashed var(--accent-border);
	}

	.link span {
		position: relative;
		background: var(--bg);
		padding: 2px 8px;
		font-size: 11px;
		color: var(--muted);
		text-align: center;
		line-height: 1.3;
	}

	.parts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
		max-width: 920px;
		margin: 0 auto;
	}

	.part h3 {
		font-size: 19px;
		margin: 6px 0 8px;
	}

	.part p:last-child {
		font-size: 15px;
		color: var(--muted);
	}

	@media (max-width: 860px) {
		.diagram {
			grid-template-columns: 1fr;
		}
		.link {
			width: auto;
			height: 64px;
		}
		.link::before {
			left: 50%;
			right: auto;
			top: 0;
			bottom: 0;
			border-top: 0;
			border-left: 1px dashed var(--accent-border);
		}
		.parts {
			grid-template-columns: 1fr;
		}
	}
</style>
