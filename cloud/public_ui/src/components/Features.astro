---
const features = [
	{
		title: 'Your repo is the source of truth',
		body: 'Commit a .underleaf/deploy.yaml next to your code. Deploying is one command, and redeploying updates the same deployment in place.',
		icon: 'M6 3v12M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM18 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM18 9a9 9 0 0 1-9 9',
	},
	{
		title: 'Runs fully local',
		body: 'The orchestrator, its API and its UI run beside your nodes. Day-to-day management never depends on a round trip to our servers.',
		icon: 'M3 5h18v11H3zM8 21h8M12 16v5',
	},
	{
		title: 'Containers, reconciled',
		body: 'Pull an image or build from source. Underleaf compares what should run with what does and brings the two into line.',
		icon: 'M21 12a9 9 0 1 1-3-6.7M21 4v5h-5',
	},
	{
		title: 'Nodes join a private mesh',
		body: 'Agents on each machine connect to one another over an encrypted network mesh, so a cluster can span rooms, sites or clouds.',
		icon: 'M12 5a2 2 0 1 0 0 .01M5 19a2 2 0 1 0 0 .01M19 19a2 2 0 1 0 0 .01M12 7l-6 10M12 7l6 10M7 19h10',
	},
	{
		title: 'One command line',
		body: 'ufctl brings cluster commands and node commands under a single name, with a local web UI when you would rather click.',
		icon: 'M4 17l6-5-6-5M12 19h8',
	},
	{
		title: 'Pay for what you use',
		body: 'Everything local is free of artificial limits. You are billed for usage on the cloud features that actually cost us something to run.',
		icon: 'M12 3v18M16 7.5C16 6 14.2 5 12 5S8 6 8 8c0 4 8 2 8 6 0 2-1.8 3-4 3s-4-1-4-2.5',
	},
];
---

<section class="section" id="features">
	<div class="container">
		<div class="section-head">
			<h2>A small, simple client with a big reach</h2>
			<p>Everything you need to run your own apps, nothing that needs a control tower.</p>
		</div>
		<div class="grid">
			{
				features.map((f) => (
					<article class="card">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d={f.icon} />
						</svg>
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.card svg {
		color: var(--accent);
	}

	h3 {
		font-size: 19px;
		margin: 20px 0 8px;
	}

	.card p {
		font-size: 15px;
		color: var(--muted);
	}

	@media (max-width: 960px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.card {
			padding: 24px;
		}
	}
</style>
