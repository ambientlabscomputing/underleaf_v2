# The virtualenv everything below runs from. Override to test: make install VENV=/tmp/venv
VENV ?= .venv

# Create the virtualenv if it is missing and install the locked dependencies,
# including the dev group (pytest, httpx), into it with uv (see uv.lock). Never
# into whatever Python happens to be first on PATH.
install:
	UV_PROJECT_ENVIRONMENT=$(VENV) uv sync

# Start the dev database: reuse the container if it exists (its data is kept),
# otherwise create it. A plain `docker run` fails once the container exists.
db-up:
	@if docker inspect cloud-api-db >/dev/null 2>&1; then \
		docker start cloud-api-db >/dev/null && echo "cloud-api-db started"; \
	else \
		docker run -d \
			--name cloud-api-db \
			-e POSTGRES_USER=postgres \
			-e POSTGRES_PASSWORD=postgres \
			-e POSTGRES_DB=postgres \
			-p 5432:5432 \
			postgres:18; \
	fi

# Wait until Postgres accepts TCP connections (the image's init phase listens on
# a unix socket only, so this does not return early).
db-wait:
	@until docker exec cloud-api-db pg_isready -q -h 127.0.0.1 -U postgres; do sleep 1; done

db-down:
	-docker stop cloud-api-db
	-docker rm cloud-api-db

env-up: db-up

# Migration failure is a warning, not fatal: a dev database migrated by another
# branch is ahead of this code ("Can't locate revision"), and killing the whole
# stack over that is worse than starting with the schema it has.
run: db-up db-wait
	-@$(MAKE) migrate || echo "WARNING: alembic upgrade failed; starting with the database as it is"
	PYTHONPATH=src $(VENV)/bin/python -m cloud_api.main

proto:
	@$(VENV)/bin/python -m grpc_tools.protoc --python_out=src/cloud_api/lib/conn_worker_client --grpc_python_out=src/cloud_api/lib/conn_worker_client \
		-I ../conn_worker/interface/grpc \
		../conn_worker/interface/grpc/conn_worker.proto
	@sed -i '' 's/^import conn_worker_pb2/from . import conn_worker_pb2/' src/cloud_api/lib/conn_worker_client/conn_worker_pb2_grpc.py
	@(ruff check --fix -q src/cloud_api/lib/conn_worker_client; ruff format -q src/cloud_api/lib/conn_worker_client) || echo "ruff not found: pre-commit will format the generated files on commit"
	@echo "Proto files generated successfully."
	@echo "autogenerated files at: src/cloud_api/lib/conn_worker_client/"
migrate:
	PYTHONPATH=src $(VENV)/bin/alembic upgrade head

# Create/link Stripe Products + Prices for the paid plans (idempotent).
# Requires UNDERLEAF_STRIPE_API_KEY (test-mode key outside production).
stripe-sync:
	PYTHONPATH=src $(VENV)/bin/python -m cloud_api.scripts.sync_stripe_catalog

test:
	PYTHONPATH=src $(VENV)/bin/pytest

# Integration tests need Postgres + migrations: `make db-up migrate test`.
